{
  "displayName": "APC Access",
  "name": "homebridge-apcaccess",
  "version": "2.0.0",
  "description": "Homebridge plugin exposing an apcupsd UPS (via its NIS server) as battery, contact and temperature sensors",
  "main": "index.js",
  "scripts": {
    "test": "npm run lint && npm run format:check && node --test test/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "apc",
    "apcaccess",
    "apcupsd"
  ],
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "author": "Paul Curry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santiagosony/homebridge-apcaccess.git"
  },
  "bugs": {
    "url": "https://github.com/santiagosony/homebridge-apcaccess/issues"
  },
  "homepage": "https://github.com/santiagosony/homebridge-apcaccess#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "homebridge": "^2.4.0",
    "prettier": "^3.9.10"
  },
  "files": [
    "index.js",
    "lib/",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
